<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- almond eye body -->
    <path
        android:fillColor="#1A1916"
        android:pathData="M26,54 C32,38 76,38 82,54 C76,70 32,70 26,54 z"/>

    <!-- iris with terracotta gradient -->
    <path android:pathData="M54,42 A12,12 0 1 1 54,66 A12,12 0 1 1 54,42 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="42" android:startY="42"
                android:endX="66"   android:endY="66">
                <item android:offset="0" android:color="#C25A33"/>
                <item android:offset="1" android:color="#7A2E14"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- pupil -->
    <path
        android:fillColor="#14130F"
        android:pathData="M54,50 A4.2,4.2 0 1 1 54,58.4 A4.2,4.2 0 1 1 54,50 z"/>

    <!-- catchlight -->
    <path
        android:fillColor="#F5EFE0"
        android:pathData="M50.6,50.6 A1.7,1.7 0 1 1 50.6,54 A1.7,1.7 0 1 1 50.6,50.6 z"/>

    <!-- upper lash arc -->
    <path
        android:strokeColor="#1A1916"
        android:strokeWidth="2.4"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M27,53 C32,38 76,38 81,53"/>

    <!-- three meditation arcs (terracotta, fading) -->
    <path
        android:strokeColor="#C25A33"
        android:strokeWidth="1.2"
        android:fillColor="#00000000"
        android:pathData="M32,36 C42,26 66,26 76,36"/>
    <path
        android:strokeColor="#C25A33"
        android:strokeWidth="1.0"
        android:strokeAlpha="0.55"
        android:fillColor="#00000000"
        android:pathData="M38,30 C46,22 62,22 70,30"/>
    <path
        android:strokeColor="#C25A33"
        android:strokeWidth="0.8"
        android:strokeAlpha="0.30"
        android:fillColor="#00000000"
        android:pathData="M44,25 C50,19 58,19 64,25"/>
</vector>
